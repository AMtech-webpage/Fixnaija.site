# ==============================================================================
# FIXNAIJA ENVIRONMENT CONFIGURATION
# Firebase Authentication + Supabase PostgreSQL & Storage Architecture
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE AUTHENTICATION (Client-Side Safe)
# Obtain from Firebase Console -> Project Settings -> General -> Web App
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKeyHere12345678"
VITE_FIREBASE_AUTH_DOMAIN="fixnaija-prod.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="fixnaija-prod"
VITE_FIREBASE_STORAGE_BUCKET="fixnaija-prod.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="85864015996"
VITE_FIREBASE_APP_ID="1:85864015996:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & STORAGE (Client-Side Safe)
# Obtain from Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://yourprojectid.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXJwcm9qZWN0aWQiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTcwMDAwMDAwMCwiZXhwIjoyMDAwMDAwMDAwfQ.YourSupabaseAnonKey"

# ------------------------------------------------------------------------------
# 3. BACKEND SERVER-SIDE ONLY SECRETS (NEVER EXPOSE IN FRONTEND VITE CODE)
# ------------------------------------------------------------------------------
# Supabase Service Role Key: Used by server.ts to sync profiles and bypass RLS on verified Firebase token sync
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YourSupabaseServiceRoleKeyHere"

# Supabase JWT Secret: Used by server.ts to mint Supabase-compatible JWTs for verified Firebase users
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Port for Express Full-Stack Server
PORT=3000
